select e.nombre,e.apellido,a.asignatura,ra.calificacion,ra.descripcion from resultados_academicos ra 
inner join estudiantes e on  ra.estudiante = e.estudiante_id
inner join asignaturas a on ra.asignatura=a.asignatura_id
group by e.nombre,e.apellido,a.asignatura,ra.descripcion;

select e.nombre ,e.apellido,c.caracterizacion,p.nombre,p.apellido,c.fecha from caracterizacion_psicopedagogica c
inner join estudiantes e 
on c.estudiante =e.estudiante_id 
inner join profesores p
on c.profesor=p.profesor_id;

