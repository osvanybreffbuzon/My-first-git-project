CREATE DATABASE perozo;

CREATE  TABLE cargos (
cargo_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, 
nombre VARCHAR(30) NOT NULL,
descripcion VARCHAR (100) DEFAULT "Sin descripcion");

CREATE TABLE profesores(
profesor_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, 
 nombre VARCHAR(30) NOT NULL,
 apellido VARCHAR(30) NOT NULL,
 edad VARCHAR(30) NOT NULL,
 sexo CHAR(9) NOT NULL,
 direccion VARCHAR(100) NOT NULL,
 cargo INT UNSIGNED,
 FOREIGN KEY(cargo) REFERENCES cargos(cargo_id)
 );

 CREATE TABLE asignaturas (
 asignatura_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
 asignatura VARCHAR(30) NOT NULL
 );

CREATE TABLE grupos(
grupo_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, 
grupo INT UNSIGNED
  );
  
CREATE TABLE grados (
 grado_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, 
grado VARCHAR (20) NOT NULL
);

CREATE TABLE grupos_x_grados(
gpg_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
grado INT UNSIGNED,
grupo INT UNSIGNED,
profesor INT UNSIGNED, 
matricula INT UNSIGNED DEFAULT 0,
FOREIGN KEY(grado) REFERENCES grados(grado_id),
FOREIGN KEY (grupo) REFERENCES grupos(grupo_id),
FOREIGN KEY(profesor) REFERENCES profesores(profesor_id)
  );

CREATE TABLE profesor_x_asignaturas(
 pa_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
 profesor INT UNSIGNED,
 asignatura INT UNSIGNED,
 grado INT UNSIGNED, 
 FOREIGN KEY(profesor) REFERENCES profesores(profesor_id),
 FOREIGN KEY(asignatura) REFERENCES asignaturas( asignatura_id),
FOREIGN KEY(grado) REFERENCES grados(grado_id)
   );

CREATE TABLE estudiantes (
estudiante_id  INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, 
nombre VARCHAR (30) NOT NULL, 
apellido VARCHAR (30) NOT NULL, 
sexo CHAR (9) NOT NULL,
edad INT UNSIGNED DEFAULT 0,
direccion VARCHAR (100) NOT NULL DEFAULT "Sin direccion", 
grado INT UNSIGNED, 
grupo INT UNSIGNED,
FOREIGN KEY(grado) REFERENCES  grados(grado_id),
FOREIGN KEY(grupo) REFERENCES  grupos(grupo_id)
);

CREATE TABLE caracterizacion_psicopedagogica(
   id_caracterizacion  INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
   caracterizacion TEXT NOT NULL,
   estudiante INT UNSIGNED,
   profesor INT UNSIGNED,
  fecha CHAR(9) NOT NULL,
  FOREIGN KEY(estudiante) REFERENCES        estudiantes(estudiante_id),
  FOREIGN KEY(profesor) REFERENCES        profesores(profesor_id)
   );
 
CREATE TABLE resultados_academicos(
  ra_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY, 
  estudiante INT UNSIGNED, 
  asignatura INT UNSIGNED, 
  calificacion DECIMAL(4,2) UNSIGNED,
  descripcion CHAR(3) DEFAULT "S/N",
  fecha CHAR(9),
  FOREIGN KEY(estudiante) REFERENCES        estudiantes(estudiante_id),
  FOREIGN KEY(asignatura) REFERENCES      asignaturas (asignatura_id) 
);

